rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function owner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function optionalString(data, field, maxSize) {
      return !(field in data) || (data[field] is string && data[field].size() <= maxSize);
    }
    function optionalNumber(data, field) {
      return !(field in data) || data[field] is number;
    }
    function optionalList(data, field, maxSize) {
      return !(field in data) || (data[field] is list && data[field].size() <= maxSize);
    }

    // Sammlungseintrag: Pflichtfelder mit Typ- und Größenprüfung.
    function validCard(cardId) {
      let data = request.resource.data;
      return data.keys().size() <= 40
        && data.id == cardId
        && data.name is string && data.name.size() > 0 && data.name.size() <= 300
        && data.set is string && data.set.size() <= 20
        && data.collectorNumber is string && data.collectorNumber.size() <= 20
        && data.count is int && data.count >= 0 && data.count <= 100000
        && data.foil is bool
        && data.manaValue is number
        && data.colors is list && data.colors.size() <= 6
        && data.colorIdentity is list && data.colorIdentity.size() <= 6
        && (!('finishCounts' in data) || (
          data.finishCounts is map
          && data.finishCounts.nonfoil is int && data.finishCounts.nonfoil >= 0
          && data.finishCounts.foil is int && data.finishCounts.foil >= 0))
        && optionalString(data, 'comment', 2000)
        && optionalString(data, 'oracleText', 10000)
        && optionalString(data, 'typeLine', 300)
        && optionalString(data, 'location', 300)
        && optionalString(data, 'condition', 100)
        && optionalList(data, 'tags', 50)
        && optionalNumber(data, 'priceEur')
        && optionalNumber(data, 'priceEurFoil');
    }

    // Deck: Pflichtfelder plus Obergrenzen für Listen (Firestore-Limit 1 MiB je Dokument).
    function validDeck(deckId) {
      let data = request.resource.data;
      return data.keys().size() <= 40
        && data.id == deckId
        && data.name is string && data.name.size() <= 200
        && data.format in ['commander', 'standard']
        && data.commanderIds is list && data.commanderIds.size() <= 2
        && data.cards is list && data.cards.size() <= 500
        && data.sideboard is list && data.sideboard.size() <= 200
        && data.colors is list && data.colors.size() <= 6
        && data.createdAt is number
        && data.updatedAt is number
        && optionalString(data, 'notes', 50000)
        && optionalList(data, 'sourceCards', 700);
    }

    // Tauschangebot im Marketplace: öffentliche Angaben, ID = <ownerId>_<cardId>.
    // Bilder dürfen nur von Scryfall stammen (kein fremdes Tracking über Bild-URLs).
    function validListing(listingId) {
      let data = request.resource.data;
      return data.keys().size() <= 20
        && data.ownerId == request.auth.uid
        && data.cardId is string && data.cardId.size() > 0 && data.cardId.size() <= 80
        && listingId == data.ownerId + '_' + data.cardId
        && data.ownerName is string && data.ownerName.size() >= 2 && data.ownerName.size() <= 30
        && !data.ownerName.matches('.*@.*')
        && data.name is string && data.name.size() > 0 && data.name.size() <= 300
        && data.nameLower is string && data.nameLower.size() <= 300
        && data.set is string && data.set.size() <= 20
        && data.collectorNumber is string && data.collectorNumber.size() <= 20
        && data.lang is string && data.lang.size() <= 10
        && data.offered is map
        && data.offered.nonfoil is int && data.offered.nonfoil >= 0 && data.offered.nonfoil <= 1000
        && data.offered.foil is int && data.offered.foil >= 0 && data.offered.foil <= 1000
        && data.offered.nonfoil + data.offered.foil > 0
        && data.createdAt is number
        && data.updatedAt is number
        && optionalString(data, 'setName', 100)
        && optionalString(data, 'typeLine', 300)
        && (!('imageUri' in data) || (
          data.imageUri is string
          && data.imageUri.size() <= 500
          && data.imageUri.matches('https://cards[.]scryfall[.]io/.*')))
        && optionalNumber(data, 'priceEur')
        && optionalNumber(data, 'priceEurFoil');
    }

    match /users/{userId} {
      allow read, delete: if owner(userId);
      allow create, update: if owner(userId)
        && request.resource.data.keys().size() <= 10
        && optionalString(request.resource.data, 'email', 320)
        && optionalString(request.resource.data, 'displayName', 40);

      match /collection/{cardId} {
        allow read, delete: if owner(userId);
        allow create, update: if owner(userId) && validCard(cardId);
      }

      match /decks/{deckId} {
        allow read, delete: if owner(userId);
        allow create, update: if owner(userId) && validDeck(deckId);
      }
    }

    // Marketplace: nur angemeldete Spieler lesen; jeder verwaltet nur eigene Angebote.
    match /marketListings/{listingId} {
      allow read: if signedIn();
      allow create: if signedIn() && validListing(listingId);
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && validListing(listingId);
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // rateLimits/* wird nur von der Cloud Function (Admin SDK) geschrieben.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
